# Production environment template (separate host/DB/secrets from staging; real data only after #48)
APP_ENV=production
APP_DOMAIN=tanys.example.kz
TLS_EMAIL=ops@tanys.example.kz

IMAGE_REPO=meiirzhan04/tanys
RELEASE_TAG=REPLACE_WITH_VERIFIED_STAGING_SHA

POSTGRES_DB=tanys_prod
POSTGRES_USER=tanys_prod
POSTGRES_PASSWORD=REPLACE_WITH_PRODUCTION_DB_SECRET

SESSION_SECRET=REPLACE_WITH_64_HEX_PRODUCTION_SESSION_SECRET

SMTP_URL=smtps://mailer:REPLACE_WITH_PRODUCTION_SMTP_SECRET@smtp.example.kz:465
MAIL_FROM="Tanys <no-reply@tanys.example.kz>"
ALERT_WEBHOOK_URL=https://hooks.example.kz/tanys-production-alerts
BACKUP_RETENTION_DAYS=30
