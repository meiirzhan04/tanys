# Staging environment template (synthetic data only; separate DB and keys from production)
APP_ENV=staging
APP_DOMAIN=staging.tanys.example.kz
TLS_EMAIL=ops@tanys.example.kz

IMAGE_REPO=meiirzhan04/tanys
RELEASE_TAG=latest

POSTGRES_DB=tanys_staging
POSTGRES_USER=tanys_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DB_SECRET

SESSION_SECRET=REPLACE_WITH_64_HEX_STAGING_SESSION_SECRET

SMTP_URL=smtps://staging-mailer:REPLACE_WITH_STAGING_SMTP_SECRET@smtp.example.kz:465
MAIL_FROM="Tanys Staging <no-reply@staging.tanys.example.kz>"
ALERT_WEBHOOK_URL=https://hooks.example.kz/tanys-staging-alerts
BACKUP_RETENTION_DAYS=30
