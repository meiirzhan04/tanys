{
  email {$TLS_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  handle /api/* {
    reverse_proxy api:3000
  }

  handle /health {
    reverse_proxy api:3000
  }

  handle /ready {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:80
  }
}
