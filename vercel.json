{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "installCommand": "npm ci && npm ci --prefix server && npm run build --prefix server",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/gateway?__route=:path*" },
    { "source": "/invite/:eventId/:token?", "destination": "/index.html" },
    { "source": "/events/:eventId?", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" }
  ]
}
